#!/bin/bash

# Put a GIF into the focused application.
#
#   gif-insert <url>
#       Copies the URL as text and pastes it. Chat clients unfurl it.
#
#   gif-insert --media <id> <gif-url> [gif|file]
#       Downloads the GIF itself and copies the bytes (image/gif) or a file
#       reference (text/uri-list), then pastes. Use this where a link renders
#       as a dull preview and you want the animation inline.
#
# Either way the clipboard keeps its contents afterwards, so the paste lands in
# clipboard history and can be repeated.

set -uo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gif-net.sh
source "$HERE/gif-net.sh"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/gifs"

notify() {
  command -v omarchy-notification-send >/dev/null 2>&1 &&
    omarchy-notification-send "GIFs" "$1" 2>/dev/null
}

# Give the compositor a beat to publish the new selection before pasting,
# otherwise wtype races wl-copy and the old clipboard contents go in.
paste_now() {
  sleep 0.15
  wtype -M shift -k Insert -m shift 2>/dev/null || true
}

# Fetch the GIF into the cache and echo its path. gif_fetch_media enforces the
# host allowlist and the byte cap, so what lands in the cache -- and what is
# handed to ImageMagick below -- is bounded and came from the provider.
fetch_gif() {
  local id="$1" url="$2" dest="$CACHE_DIR/$id.full.gif"

  mkdir -p "$CACHE_DIR"
  if [[ ! -s $dest ]]; then
    gif_fetch_media "$url" "$dest" "$GIF_MAX_MEDIA_BYTES" || return 1
  fi
  printf '%s' "$dest"
}

# Escape for an HTML attribute. The URL comes from a provider response, so it
# is not ours to trust: an unescaped quote would end the src attribute and let
# the response put markup of its choosing on the clipboard.
html_escape() {
  local s="$1"
  # The replacements are quoted because bash 5.2's patsub_replacement expands a
  # bare & in a replacement to the text that matched, which would turn "<" into
  # "<lt;" instead of "&lt;".
  s=${s//&/"&amp;"}
  s=${s//</"&lt;"}
  s=${s//>/"&gt;"}
  s=${s//\"/"&quot;"}
  printf '%s' "$s"
}

if [[ ${1:-} == "--media" ]]; then
  id="${2:-}"
  url="${3:-}"
  as="${4:-html}"

  [[ -n $id && -n $url ]] || exit 1
  # The id becomes a filename, so refuse anything that could escape the cache.
  [[ $id =~ ^[A-Za-z0-9_-]+$ ]] || exit 1
  # Every mode below either downloads this URL or puts it somewhere the
  # receiving application will fetch it from, so check it once here.
  if ! gif_url_allowed "$url"; then
    notify "That GIF is not on an allowed provider host"
    exit 1
  fi

  # wl-copy serves exactly one MIME type per invocation, so each mode is a
  # different bet about what the receiving app asks the clipboard for.
  case "$as" in
    html)
      # What a browser puts on the clipboard when you copy an image: HTML with
      # a remote <img>. Rich compose boxes (Teams, and most webmail) fetch the
      # URL, which keeps the animation. Needs no download, so it is instant.
      printf '<img src="%s">' "$(html_escape "$url")" | wl-copy --type text/html
      ;;

    png)
      # The one format every app accepts -- it is what a screenshot puts on the
      # clipboard -- but PNG cannot animate, so this pastes the first frame.
      dest=$(fetch_gif "$id" "$url") || { notify "Could not download that GIF"; exit 1; }
      if ! command -v magick >/dev/null 2>&1; then
        notify "shiftPaste=png needs imagemagick"
        exit 1
      fi
      # "gif:" pins the reader. Without it ImageMagick picks a coder by
      # sniffing the content, so a response that is not really a GIF would be
      # decoded by whichever coder matches -- SVG, MVG, EPS -- and some of
      # those reach delegates. These bytes came off the network, so the format
      # is ours to declare, not the file's to suggest.
      #
      # The resource limits are so that a crafted or simply enormous GIF
      # cannot turn a paste into an out-of-memory event: we want frame one.
      if ! magick -limit memory 256MiB -limit map 512MiB -limit area 128MP \
        "gif:$dest[0]" png:- 2>/dev/null | wl-copy --type image/png; then
        notify "Could not convert that GIF"
        exit 1
      fi
      ;;

    file)
      # A file reference is what a file manager puts on the clipboard, so apps
      # that accept pasted files treat this as an attachment.
      dest=$(fetch_gif "$id" "$url") || { notify "Could not download that GIF"; exit 1; }
      printf 'file://%s\n' "$dest" | wl-copy --type text/uri-list
      ;;

    gif|*)
      # The real bytes. Correct, and works in apps that ask for image/gif --
      # but Chromium and Electron apps only ever ask for image/png, so this
      # silently pastes nothing there.
      dest=$(fetch_gif "$id" "$url") || { notify "Could not download that GIF"; exit 1; }
      wl-copy --type image/gif <"$dest"
      ;;
  esac

  paste_now
  exit 0
fi

url="${1:-}"
[[ -n $url ]] || exit 1
if ! gif_url_allowed "$url"; then
  notify "That link is not on an allowed provider host"
  exit 1
fi

printf '%s' "$url" | wl-copy --type text/plain
paste_now
