#!/bin/bash

# Download a favorited GIF's preview and animation into the local cache so
# favorites still render with no network. Named by Tenor id, so the picker can
# derive the paths without asking.
#
# Usage:  gif-cache <id> <preview-url> <tiny-gif-url>
# Output: "anim" and/or "preview", naming what is actually on disk afterwards.
#         The preview and the animation fail independently, and the picker
#         renders local files only, so it needs to know which it got rather
#         than inferring both from the exit status.
# Exit:   0 if the animation is on disk, 1 otherwise.

set -uo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gif-net.sh
source "$HERE/gif-net.sh"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/gifs"

id="${1:-}"
preview_url="${2:-}"
tiny_url="${3:-}"

[[ -n $id ]] || exit 1
# The id becomes a filename, so refuse anything that could escape the cache dir.
[[ $id =~ ^[A-Za-z0-9_-]+$ ]] || exit 1

mkdir -p "$CACHE_DIR"

# gif_fetch_media downloads to a temp name and renames, so a killed or
# oversized curl never leaves a truncated file that later reads as a valid
# cache hit, and it refuses a URL -- or a redirect -- that leaves the provider.
fetch() {
  local url="$1" dest="$2"
  [[ -n $url ]] || return 0
  [[ -s $dest ]] && return 0
  gif_fetch_media "$url" "$dest" "$GIF_MAX_PREVIEW_BYTES" || return 0
}

fetch "$preview_url" "$CACHE_DIR/$id.preview"
fetch "$tiny_url" "$CACHE_DIR/$id.tiny.gif"

# Report on the files themselves, not on what the downloads returned.
[[ -s $CACHE_DIR/$id.preview ]]  && printf 'preview\n'
[[ -s $CACHE_DIR/$id.tiny.gif ]] && printf 'anim\n'

gif_prune_cache "$CACHE_DIR"

# The picker treats a zero exit as "the animation is on disk now" and points
# AnimatedImage at it, so a failed download must not report success.
[[ -s $CACHE_DIR/$id.tiny.gif ]] || exit 1
exit 0
