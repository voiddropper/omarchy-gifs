#!/bin/bash

# Query the configured GIF provider and print a normalized result list.
# The API key is read from disk here and never passed as an argument, so it
# stays out of the process table and out of the shell's QML.
#
# Usage: gif-search <query>   |   gif-search --featured
# Output: {"ok":true,"results":[...]}  or  {"ok":false,"error":"<code>"}

set -uo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=gif-providers.sh
source "$HERE/gif-providers.sh"

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/gifs/config.json"

emit_error() {
  jq -cn --arg e "$1" '{ok: false, error: $e, results: []}'
  exit 0
}

[[ -f $CONFIG ]] || emit_error "no-config"

provider=$(jq -r '.provider // "giphy"' "$CONFIG" 2>/dev/null) || emit_error "bad-config"

# Keys are stored per provider so switching providers does not lose the other
# key. A flat "apiKey" from an older config still works for the active one.
api_key=$(jq -r --arg p "$provider" '.apiKeys[$p] // .apiKey // ""' "$CONFIG" 2>/dev/null) \
  || emit_error "bad-config"
[[ -n $api_key && $api_key != "null" ]] || emit_error "no-key"

limit=$(jq -r '.limit // 50' "$CONFIG" 2>/dev/null)
[[ $limit =~ ^[0-9]+$ ]] || limit=50
# Both providers cap a free key at 50 results per request; KLIPY's floor is 8.
(( limit > 50 )) && limit=50
(( limit < 8 )) && limit=8

content_filter=$(jq -r '.contentFilter // "medium"' "$CONFIG" 2>/dev/null)
[[ $content_filter =~ ^(off|low|medium|high)$ ]] || content_filter="medium"

if [[ ${1:-} == "--featured" ]]; then
  mode="featured"; query=""
else
  mode="search"; query="${1:-}"
  [[ -n $query ]] || emit_error "empty-query"
fi

gif_build_request "$provider" "$api_key" "$mode" "$query" "$limit" "$content_filter" \
  || emit_error "bad-provider"

raw=$(gif_http_get "${REQ_ARGS[@]}") || emit_error "network"
status="${raw##*$'\n'}"
body="${raw%$'\n'*}"

err=$(gif_status_error "$provider" "$status")
[[ -z $err ]] || emit_error "$err"
[[ -n $body ]] || emit_error "empty-response"

jq -c "$REQ_NORMALIZE" <<<"$body" 2>/dev/null || emit_error "parse"
